// -------------------- Preferences helpers --------------------
void saveChildCardsToPreferences(int room) {
  if (xSemaphoreTake(prefsMutex, portMAX_DELAY) == pdTRUE) {
    if (room == 1) {
      pref1.putInt("childCount", childCount1);
      for (int i = 0; i < childCount1; i++) {
        String key = "child" + String(i);
        pref1.putBytes(key.c_str(), childUIDs1[i], 4);
      }
    } else {
      pref2.putInt("childCount", childCount2);
      for (int i = 0; i < childCount2; i++) {
        String key = "child" + String(i);
        pref2.putBytes(key.c_str(), childUIDs2[i], 4);
      }
    }
    xSemaphoreGive(prefsMutex);
  }
}

void loadChildCardsFromPreferences(int room) {
  if (xSemaphoreTake(prefsMutex, portMAX_DELAY) == pdTRUE) {
    if (room == 1) {
      childCount1 = pref1.getInt("childCount", 0);
      if (childCount1 > MAX_CHILD_CARDS) childCount1 = 0;
      for (int i = 0; i < childCount1; i++) {
        String key = "child" + String(i);
        size_t br = pref1.getBytes(key.c_str(), childUIDs1[i], 4);
        if (br != 4) { childCount1 = i; break; }
      }
    } else {
      childCount2 = pref2.getInt("childCount", 0);
      if (childCount2 > MAX_CHILD_CARDS) childCount2 = 0;
      for (int i = 0; i < childCount2; i++) {
        String key = "child" + String(i);
        size_t br = pref2.getBytes(key.c_str(), childUIDs2[i], 4);
        if (br != 4) { childCount2 = i; break; }
      }
    }
    xSemaphoreGive(prefsMutex);
  }
}

void saveFailedAttempts(int room) {
  if (xSemaphoreTake(prefsMutex, portMAX_DELAY) == pdTRUE) {
    if (room == 1) {
      pref1.putInt("failedAttempts", failedAttempts1);
    } else {
      pref2.putInt("failedAttempts", failedAttempts2);
    }
    xSemaphoreGive(prefsMutex);
  }
}

void resetFailedAttempts(int room) {
  if (room == 1) {
    if (failedAttempts1 != 0 || childCardsLocked1) {
      failedAttempts1 = 0;
      childCardsLocked1 = false;
      alarmActive1 = false;
      saveFailedAttempts(1);
      // Cập nhật Firebase
      Firebase.setBool(fbdo, "/kho1/childlock1", false);
      Firebase.setBool(fbdo, "/kho1/alarm1", false);
      Firebase.setInt(fbdo, "/kho1/fail1", 0);
      
      if (childCount1 == 0) {
        loadChildCardsFromPreferences(1);
      }
    } else childCardsLocked1 = false;
    noTone(BUZZER_PIN);
    digitalWrite(LED_PIN, LOW);
  } else {
    if (failedAttempts2 != 0 || childCardsLocked2) {
      failedAttempts2 = 0;
      childCardsLocked2 = false;
      alarmActive2 = false;
      saveFailedAttempts(2);
      // Cập nhật Firebase
      Firebase.setBool(fbdo, "/kho2/childlock2", false);
      Firebase.setBool(fbdo, "/kho2/alarm2", false);
      Firebase.setInt(fbdo, "/kho2/fail2", 0);
      
      if (childCount2 == 0) {
        loadChildCardsFromPreferences(2);
      }
    } else childCardsLocked2 = false;
    noTone(BUZZER_PIN);
    digitalWrite(LED_PIN, LOW);
  }
}

void deleteAllChildCards(int room) {
  if (xSemaphoreTake(prefsMutex, portMAX_DELAY) == pdTRUE) {
    if (room == 1) {
      childCount1 = 0;
      pref1.putInt("childCount", 0);
      for (int i = 0; i < MAX_CHILD_CARDS; i++) {
        String key = "child" + String(i);
        if (pref1.isKey(key.c_str())) pref1.remove(key.c_str());
      }
    } else {
      childCount2 = 0;
      pref2.putInt("childCount", 0);
      for (int i = 0; i < MAX_CHILD_CARDS; i++) {
        String key = "child" + String(i);
        if (pref2.isKey(key.c_str())) pref2.remove(key.c_str());
      }
    }
    xSemaphoreGive(prefsMutex);
  }
}

// -------------------- Helper checks --------------------
bool checkIfMaster(byte* uid, byte size, int room) {
  if (room == 1) {
    if (size != MASTER_UID1_LEN) return false;
    for (byte i = 0; i < MASTER_UID1_LEN; i++) if (uid[i] != masterUID1[i]) return false;
    return true;
  } else {
    if (size != MASTER_UID2_LEN) return false;
    for (byte i = 0; i < MASTER_UID2_LEN; i++) if (uid[i] != masterUID2[i]) return false;
    return true;
  }
}

bool checkIfChildInRoom(byte* uid, byte size, int room) {
  if (size != 4) return false;
  if (room == 1) {
    for (int i = 0; i < childCount1; i++) {
      bool match = true;
      for (byte j = 0; j < 4; j++) if (uid[j] != childUIDs1[i][j]) { match = false; break; }
      if (match) return true;
    }
  } else {
    for (int i = 0; i < childCount2; i++) {
      bool match = true;
      for (byte j = 0; j < 4; j++) if (uid[j] != childUIDs2[i][j]) { match = false; break; }
      if (match) return true;
    }
  }
  return false;
}

int findChildCardRoom(byte* uid, byte size) {
  if (size != 4) return 0;
  for (int i = 0; i < childCount1; i++) {
    bool match = true;
    for (byte j = 0; j < 4; j++) if (uid[j] != childUIDs1[i][j]) { match = false; break; }
    if (match) return 1;
  }
  for (int i = 0; i < childCount2; i++) {
    bool match = true;
    for (byte j = 0; j < 4; j++) if (uid[j] != childUIDs2[i][j]) { match = false; break; }
    if (match) return 2;
  }
  return 0;
}

// -------------------- SIM functions --------------------
String readFromSIM(uint32_t timeout) {
  String data = "";
  unsigned long start = millis();
  while (millis() - start < timeout) {
    while (moduleSim.available()) {
      data += moduleSim.readString();
      delay(2);
    }
    if (data.indexOf("+CMT:") >= 0 && data.indexOf("\n\n") >= 0) break;
    vTaskDelay(pdMS_TO_TICKS(10));
  }
  return data;
}

bool waitForSIM(String expected, uint32_t timeout) {
  unsigned long start = millis();
  String response = "";
  while (millis() - start < timeout) {
    while (moduleSim.available()) {
      response += moduleSim.readString();
      delay(2);
    }
    if (response.indexOf(expected) >= 0) return true;
    vTaskDelay(pdMS_TO_TICKS(10));
  }
  return false;
}

bool sendSMS(String phone, String content) {
  moduleSim.println("AT+CMGF=1");
  if (!waitForSIM("OK", 1000)) return false;
  moduleSim.print("AT+CMGS=\"");
  moduleSim.print(phone);
  moduleSim.println("\"");
  if (!waitForSIM(">", 3000)) return false;
  moduleSim.print(content);
  moduleSim.write(26);
  return (waitForSIM("OK", 10000) || waitForSIM("+CMGS", 5000));
}

