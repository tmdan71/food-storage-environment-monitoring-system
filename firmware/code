void TaskRFID(void *pvParameters) {
  RFIDMessage msg;
  for (;;) {
    if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
      if (mfrc522.uid.size >= 4) {
        memcpy(msg.uid, mfrc522.uid.uidByte, 4);
