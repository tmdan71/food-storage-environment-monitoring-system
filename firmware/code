char getKey_raw() {
  char key = 0;
  for (byte c = 0; c < COLS; c++) {
    digitalWrite(colPins[c], LOW);
    for (byte r = 0; r < ROWS; r++) {
      if (digitalRead(rowPins[r]) == LOW) {
        delay(5);
        if (digitalRead(rowPins[r]) == LOW) {
          key = keysArr[r][c];
          unsigned long waitStart = millis();
          while (digitalRead(rowPins[r]) == LOW) {
            if (millis() - waitStart > 200) break;
            vTaskDelay(pdMS_TO_TICKS(1));
          }
          break;
        }
      }
    }
    digitalWrite(colPins[c], HIGH);
    if (key != 0) break;
  }
  return key;
}


void TaskKeypad(void *pvParameters) {
  char key;
  for (;;) {
    key = getKey_raw();
    if (key != 0) {
      xQueueSend(queueKeypad, &key, 0);
      vTaskDelay(pdMS_TO_TICKS(KEY_DEBOUNCE_TIME));
    }
    vTaskDelay(pdMS_TO_TICKS(200));
  }
}

void TaskSensors(void *pvParameters) {
  unsigned long lastPIR1 = 0, lastPIR2 = 0;
  
  for (;;) {
    unsigned long now = millis();
    
    if (now - lastPIRRead1 >= PIR_READ_INTERVAL) {
      lastPIRRead1 = now;
      bool currentMotion = digitalRead(PIR_PIN_1);
      
      if (lastAuto1State && currentMotion && !lastMotionState1 && lightOnUntil1 == 0) {
        motionDetected1 = true; 
        lastMotionTime1 = now;
        
        digitalWrite(PIR_RELAY_PIN_1, HIGH);
        lightOnUntil1 = now + MOTION_TIMEOUT;
      }
      lastMotionState1 = currentMotion;
    }
    
    if (now - lastPIRRead2 >= PIR_READ_INTERVAL) {
      lastPIRRead2 = now;
      bool currentMotion = digitalRead(PIR_PIN_2);
      
      if (lastAuto2State && currentMotion && !lastMotionState2 && lightOnUntil2 == 0) {
        motionDetected2 = true; 
        lastMotionTime2 = now;
        
        digitalWrite(PIR_RELAY_PIN_2, HIGH);
        lightOnUntil2 = now + MOTION_TIMEOUT;
      }
      lastMotionState2 = currentMotion;
    }

    if (lastAuto1State && lightOnUntil1 > 0 && now >= lightOnUntil1 && lightOnUntil1 != 0) {
      digitalWrite(PIR_RELAY_PIN_1, LOW);
      lightOnUntil1 = 0;
      motionDetected1 = false;
    }
    if (lastAuto2State && lightOnUntil2 > 0 && now >= lightOnUntil2 && lightOnUntil2 != 0) {
      digitalWrite(PIR_RELAY_PIN_2, LOW);
      lightOnUntil2 = 0;
      motionDetected2 = false;
    }

    bool eb1 = digitalRead(EMERGENCY_BUTTON_PIN_1);
    if (eb1 == LOW && lastEmergencyButtonState1 == HIGH) {
      emergencyButtonPressTime1 = now;
      postDisplayMessage("EMERGENCY P1\nHold 3s to open...");
    }
    if (eb1 == LOW) {
      unsigned long holdTime = now - emergencyButtonPressTime1;
      if (holdTime >= EMERGENCY_HOLD_DURATION) {
        postDisplayMessage("EMERGENCY OPEN P1");
        resetFailedAttempts(1);
        openLock(1);
        for (int i=0;i<3;i++){ tone(BUZZER_PIN, 1000, 300); vTaskDelay(pdMS_TO_TICKS(350)); }
      }
    }
    if (eb1 == HIGH && lastEmergencyButtonState1 == LOW) {
      postDisplayMessage("EMERGENCY P1\nReleased");
    }
    lastEmergencyButtonState1 = eb1;

    bool eb2 = digitalRead(EMERGENCY_BUTTON_PIN_2);
    if (eb2 == LOW && lastEmergencyButtonState2 == HIGH) {
      emergencyButtonPressTime2 = now;
      postDisplayMessage("EMERGENCY P2\nHold 3s to open...");
    }
    if (eb2 == LOW) {
      unsigned long holdTime = now - emergencyButtonPressTime2;
      if (holdTime >= EMERGENCY_HOLD_DURATION) {
        postDisplayMessage("EMERGENCY OPEN P2");
        resetFailedAttempts(2);
        openLock(2);
        for (int i=0;i<3;i++){ tone(BUZZER_PIN, 1000, 300); vTaskDelay(pdMS_TO_TICKS(350)); }
      }
    }
    if (eb2 == HIGH && lastEmergencyButtonState2 == LOW) {
      postDisplayMessage("EMERGENCY P2\nReleased");
    }
    lastEmergencyButtonState2 = eb2;

    // ============== ĐỌC DHT MỖI 5 GIÂY ==============
    if (now - lastSensorRead >= SENSOR_INTERVAL) {
      lastSensorRead = now;
      
      // Đọc DHT1
      float t1 = dht1.readTemperature();
      float h1 = dht1.readHumidity();
      
      delay(50);  // QUAN TRỌNG: delay giữa 2 cảm biến
      
      // Đọc DHT2  
      float t2 = dht2.readTemperature();
      float h2 = dht2.readHumidity();
      
      // Lưu vào cache nếu giá trị hợp lệ (CHỈ CHECK NAN)
      if (!isnan(t1) && !isnan(h1)) {
        cachedTemp1 = t1;
        cachedHum1 = h1;
        dhtCacheValid1 = true;
      }
      
      if (!isnan(t2) && !isnan(h2)) {
        cachedTemp2 = t2;
        cachedHum2 = h2;
        dhtCacheValid2 = true;
      }
      
      // Dùng cache để kiểm tra cảnh báo
      if (dhtCacheValid1) {
        controlBuzzerAndLED(cachedTemp1, cachedHum1, 1);
      }
      if (dhtCacheValid2) {
        controlBuzzerAndLED(cachedTemp2, cachedHum2, 2);
      }
    }
    // ==============================================

    vTaskDelay(pdMS_TO_TICKS(100));
  }
}

void TaskSMS(void *pvParameters) {
  for (;;) {
    unsigned long now = millis();
    if (now - lastSMSCheck >= SMS_CHECK_INTERVAL) {
      lastSMSCheck = now;
      String data = readFromSIM(1500);
      if (data.indexOf("+CMT:") >= 0) {
        int start = data.indexOf("\"") + 1;
        int end = data.indexOf("\"", start);
        String sender = data.substring(start, end);
        int msgStart = data.indexOf("\n", end) + 1;
        String message = data.substring(msgStart);
        message.trim();
        message.toLowerCase();
        
        if (message == "kiemtra") {
          if (sender == ALLOWED_PHONE_1) sendSMS(ALLOWED_PHONE_1, "ok");
          else if (sender == ALLOWED_PHONE_2) sendSMS(ALLOWED_PHONE_2, "ok");
        } else if (message == "stat1") {
          if (sender == ALLOWED_PHONE_1) sendSMS(ALLOWED_PHONE_1, getSystemStatus(1));
        } else if (message == "stat2") {
          if (sender == ALLOWED_PHONE_2) sendSMS(ALLOWED_PHONE_2, getSystemStatus(2));
        } 
        else if (message == "auto1on") {
          if (sender == ALLOWED_PHONE_1) {
            if (lastAuto1State == false) {
              resetToAutoState(1);
            }
            lastAuto1State = true;
            Firebase.setBool(fbdo, "/kho1/auto1", true);
            sendSMS(ALLOWED_PHONE_1, "Auto mode P1: ON");
          }
        } else if (message == "auto1off") {
          if (sender == ALLOWED_PHONE_1) {
            lastAuto1State = false;
            Firebase.setBool(fbdo, "/kho1/auto1", false);
            sendSMS(ALLOWED_PHONE_1, "Auto mode P1: OFF");
          }
        } else if (message == "auto2on") {
          if (sender == ALLOWED_PHONE_2) {
            if (lastAuto2State == false) {
              resetToAutoState(2);
            }
            lastAuto2State = true;
            Firebase.setBool(fbdo, "/kho2/auto2", true);
            sendSMS(ALLOWED_PHONE_2, "Auto mode P2: ON");
          }
        } else if (message == "auto2off") {
          if (sender == ALLOWED_PHONE_2) {
            lastAuto2State = false;
            Firebase.setBool(fbdo, "/kho2/auto2", false);
            sendSMS(ALLOWED_PHONE_2, "Auto mode P2: OFF");
          }
        }
        else if (message == "lock1on") {
          if (sender == ALLOWED_PHONE_1) {
            resetSecurityOnFirebaseOpen(1);
            openLock(1);
            sendSMS(ALLOWED_PHONE_1, "Lock 1: OPENED via SMS\nAuto-close in 5s");
          }
        } 
        else if (message == "lock2on") {
          if (sender == ALLOWED_PHONE_2) {
            resetSecurityOnFirebaseOpen(2);
            openLock(2);
            sendSMS(ALLOWED_PHONE_2, "Lock 2: OPENED via SMS\nAuto-close in 5s");
          }
        }
        else if (message == "light1on") {
          if (sender == ALLOWED_PHONE_1) {
            turnOnLight(1);
            sendSMS(ALLOWED_PHONE_1, "Light 1: TURNED ON via SMS");
          }
        } 
        else if (message == "light1off") {
          if (sender == ALLOWED_PHONE_1) {
            turnOffLight(1);
            sendSMS(ALLOWED_PHONE_1, "Light 1: TURNED OFF via SMS");
          }
        }
        else if (message == "light2on") {
          if (sender == ALLOWED_PHONE_2) {
            turnOnLight(2);
            sendSMS(ALLOWED_PHONE_2, "Light 2: TURNED ON via SMS");
          }
        } 
        else if (message == "light2off") {
          if (sender == ALLOWED_PHONE_2) {
            turnOffLight(2);
            sendSMS(ALLOWED_PHONE_2, "Light 2: TURNED OFF via SMS");
          }
        }
        else if (message == "childlock1on") {
          if (sender == ALLOWED_PHONE_1) {
            childCardsLocked1 = true;
            alarmActive1 = true;
            Firebase.setBool(fbdo, "/kho1/childlock1", true);
            Firebase.setBool(fbdo, "/kho1/alarm1", true);
            sendSMS(ALLOWED_PHONE_1, "ChildLock P1: ACTIVATED");
          }
        }
        else if (message == "childlock1off") {
          if (sender == ALLOWED_PHONE_1) {
            resetFailedAttempts(1);
            sendSMS(ALLOWED_PHONE_1, "ChildLock P1: DEACTIVATED\nSystem reset");
          }
        }
        else if (message == "childlock2on") {
          if (sender == ALLOWED_PHONE_2) {
            childCardsLocked2 = true;
            alarmActive2 = true;
            Firebase.setBool(fbdo, "/kho2/childlock2", true);
            Firebase.setBool(fbdo, "/kho2/alarm2", true);
            sendSMS(ALLOWED_PHONE_2, "ChildLock P2: ACTIVATED");
          }
        }
        else if (message == "childlock2off") {
          if (sender == ALLOWED_PHONE_2) {
            resetFailedAttempts(2);
            sendSMS(ALLOWED_PHONE_2, "ChildLock P2: DEACTIVATED\nSystem reset");
          }
        }
        
        moduleSim.println("AT+CMGD=1,4");
        vTaskDelay(pdMS_TO_TICKS(100));
      }
    }
    vTaskDelay(pdMS_TO_TICKS(200));
  }
}

void TaskDisplay(void *pvParameters) {
  int idx;
  unsigned long lastBaseScreen = 0;

  for (;;) {
    if (xQueueReceive(queueDisplayIndex, &idx, 0) == pdPASS) {
      if (xSemaphoreTake(displayMutex, pdMS_TO_TICKS(200)) == pdTRUE) {
        display.clearDisplay();
        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(0,0);

        char* txt = displayPool[idx];
        int line = 0;
        char *p = strtok(txt, "\n");
        while (p != NULL && line < 4) {
          display.setCursor(0, line * 8);
          display.println(p);
          p = strtok(NULL, "\n");
          line++;
        }

        display.display();
        displayPool[idx][0] = 0;
        xSemaphoreGive(displayMutex);

        displayPriority = true;
        priorityDisplayTime = millis();
      }
    }

    if (millis() - lastBaseScreen > 2000 && !displayPriority) {
      if (xSemaphoreTake(displayMutex, pdMS_TO_TICKS(50)) == pdTRUE) {
        display.clearDisplay();
        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(0,0);
        display.println("-- KHO THONG MINH --");
        
        // Dùng cache thay vì đọc trực tiếp
        float temp1 = dhtCacheValid1 ? cachedTemp1 : 0;
        float hum1 = dhtCacheValid1 ? cachedHum1 : 0;
        float temp2 = dhtCacheValid2 ? cachedTemp2 : 0;
        float hum2 = dhtCacheValid2 ? cachedHum2 : 0;
        
        display.printf("P1: %.1fC %.0f%% %s %s\n", temp1, hum1,
                      motionDetected1 ? "ON" : "OFF", lastAuto1State ? "AU" : "MA");
        display.printf("P2: %.1fC %.0f%% %s %s\n", temp2, hum2,
                      motionDetected2 ? "ON" : "OFF", lastAuto2State ? "AU" : "MA");
        display.display();
        xSemaphoreGive(displayMutex);
      }
      lastBaseScreen = millis();
    }

    if (displayPriority && (millis() - priorityDisplayTime > priorityDisplayDuration)) {
      priorityDisplayDuration = 10000;
      displayPriority = false;
    }

    vTaskDelay(pdMS_TO_TICKS(100));
  }
}

// -------------------- Firebase Task --------------------
void TaskFirebase(void *pvParameters) {
  const unsigned long FIREBASE_READ_INTERVAL = 3000;
  const unsigned long FIREBASE_WRITE_INTERVAL = 10000;
  const unsigned long THRESHOLD_UPDATE_INTERVAL = 10000;
  const unsigned long LOCK_LIGHT_UPDATE_INTERVAL = 10000;
  
  unsigned long lastRead = 0;
  unsigned long lastWrite = 0;
  unsigned long lastThresholdUpdate = 0;
  unsigned long lastLockLightUpdate = 0;
  
  for (;;) {
    unsigned long now = millis();
    
    if (now - lastRead >= FIREBASE_READ_INTERVAL) {
      if (WiFi.status() == WL_CONNECTED) {
        controlFromFirebase();
        lastRead = now;
      }
    }
    
    if (now - lastThresholdUpdate >= THRESHOLD_UPDATE_INTERVAL) {
      if (WiFi.status() == WL_CONNECTED) {
        updateThresholdsFromFirebase();
        lastThresholdUpdate = now;
      }
    }
    
    if (now - lastWrite >= FIREBASE_WRITE_INTERVAL) {
      if (WiFi.status() == WL_CONNECTED) {
        if (!lastAuto1State && !lastAuto2State) {
          updateFirebaseSensorsOnly(1);
          updateFirebaseSensorsOnly(2);
        } else {
          updateFirebase(1);
          updateFirebase(2);
        }
        lastWrite = now;
      }
    }
    
    if ((!lastAuto1State || !lastAuto2State) && (now - lastLockLightUpdate >= LOCK_LIGHT_UPDATE_INTERVAL)) {
      if (WiFi.status() == WL_CONNECTED) {
        if (!lastAuto1State) {
          Firebase.setBool(fbdo, "/kho1/lock1", digitalRead(RELAY_PIN_1) == HIGH);
          Firebase.setBool(fbdo, "/kho1/light1", digitalRead(PIR_RELAY_PIN_1) == HIGH);
        }
        if (!lastAuto2State) {
          Firebase.setBool(fbdo, "/kho2/lock2", digitalRead(RELAY_PIN_2) == HIGH);
          Firebase.setBool(fbdo, "/kho2/light2", digitalRead(PIR_RELAY_PIN_2) == HIGH);
        }
        lastLockLightUpdate = now;
      }
    }
    
    vTaskDelay(pdMS_TO_TICKS(500));
  }
}

// -------------------- Main logic task --------------------
int findChildIndex(uint8_t uid[4], int room) {
  if (room == 1) {
    for (int i = 0; i < childCount1; i++) {
      if (memcmp(childUIDs1[i], uid, 4) == 0) return i;
    }
  } else {
    for (int i = 0; i < childCount2; i++) {
      if (memcmp(childUIDs2[i], uid, 4) == 0) return i;
    }
  }
  return -1;
}

void handleAddCard(int room, uint8_t uid[4]) {
  if (((room == 1 && !lastAuto1State) || (room == 2 && !lastAuto2State)) && 
      !checkIfMaster(uid, 4, room)) {
    postDisplayMessage("MANUAL MODE\nUse Firebase to control");
    return;
  }

  char buf[64];
  if (room == 1) {
    bool exists = checkIfChildInRoom(uid, 4, 1);
    if (!exists) {
      if (childCount1 < MAX_CHILD_CARDS) {
        for (int i = 0; i < 4; i++) childUIDs1[childCount1][i] = uid[i];
        childCount1++;
        saveChildCardsToPreferences(1);
        snprintf(buf, sizeof(buf), "CARD ADDED P1\nTotal: %d", childCount1);
        priorityDisplayDuration = 5000;
        postDisplayMessage(buf);
        beepBuzzerShort();
      } else {
        postDisplayMessage("CARD LIST FULL P1");
      }
    } else {
      postDisplayMessage("CARD EXISTS P1");
    }
  } else {
    bool exists = checkIfChildInRoom(uid, 4, 2);
    if (!exists) {
      if (childCount2 < MAX_CHILD_CARDS) {
        for (int i = 0; i < 4; i++) childUIDs2[childCount2][i] = uid[i];
        childCount2++;
        saveChildCardsToPreferences(2);
        snprintf(buf, sizeof(buf), "CARD ADDED P2\nTotal: %d", childCount2);
        priorityDisplayDuration = 5000;
        postDisplayMessage(buf);
        beepBuzzerShort();
      } else {
        postDisplayMessage("CARD LIST FULL P2");
      }
    } else {
      postDisplayMessage("CARD EXISTS P2");
    }
  }
}

void handleRemoveCard(int room, uint8_t uid[4]) {
  if (((room == 1 && !lastAuto1State) || (room == 2 && !lastAuto2State)) && 
      !checkIfMaster(uid, 4, room)) {
    postDisplayMessage("MANUAL MODE\nUse Firebase to control");
    return;
  }

  char buf[64];
  if (room == 1) {
    int index = findChildIndex(uid, 1);
    if (index != -1) {
      for (int i = index; i < childCount1 - 1; i++)
        memcpy(childUIDs1[i], childUIDs1[i + 1], 4);
      childCount1--;
      saveChildCardsToPreferences(1);
      snprintf(buf, sizeof(buf), "CARD REMOVED P1\nTotal: %d", childCount1);
      priorityDisplayDuration = 5000;
      postDisplayMessage(buf);
      beepBuzzerShort();
    } else {
      postDisplayMessage("CARD NOT FOUND P1");
    }
  } else {
    int index = findChildIndex(uid, 2);
    if (index != -1) {
      for (int i = index; i < childCount2 - 1; i++)
        memcpy(childUIDs2[i], childUIDs2[i + 1], 4);
      childCount2--;
      saveChildCardsToPreferences(2);
      snprintf(buf, sizeof(buf), "CARD REMOVED P2\nTotal: %d", childCount2);
      priorityDisplayDuration = 5000;
      postDisplayMessage(buf);
      beepBuzzerShort();
    } else {
      postDisplayMessage("CARD NOT FOUND P2");
    }
  }
}

void checkPasswordNonBlocking(int room) {
  if ((room == 1 && !lastAuto1State) || (room == 2 && !lastAuto2State)) {
    postDisplayMessage("MANUAL MODE\nChild card disabled");
    inputPassword1 = "";
    inputPassword2 = "";
    currentMode1 = MODE_NORMAL;
    currentMode2 = MODE_NORMAL;
    return;
  }

  if (room == 1) {
    if (inputPassword1 == correctPassword1) {
      resetFailedAttempts(1);
      openLock(1);
      postDisplayMessage("SUCCESS P1\nAccess granted");
      beepBuzzerShort();
    } else {
      failedAttempts1++;
      saveFailedAttempts(1);
      char buf[64];
      snprintf(buf, sizeof(buf), "FAIL P1\nFailed: %d/%d", failedAttempts1, MAX_FAILED_ATTEMPTS_LOCK);
      postDisplayMessage(buf);
      if (failedAttempts1 == MAX_FAILED_ATTEMPTS_WARNING) {
        lastFailedSMSTime1 = millis();
        sendSMS(ALLOWED_PHONE_1, "Canh bao: Kho P1 nhap sai mat khau 5 lan!");
        delay(100);
      }
      else if (failedAttempts1 > MAX_FAILED_ATTEMPTS_WARNING && failedAttempts1 < MAX_FAILED_ATTEMPTS_LOCK) beepWarning5s();
      else if (failedAttempts1 >= MAX_FAILED_ATTEMPTS_LOCK) {
        sendSMS(ALLOWED_PHONE_1, "Khoa kich hoat: Kho P1 bi khoa do 10 lan that bai!");
        delay(100);
        childCardsLocked1 = true;
        alarmActive1 = true;
        lockStartTime1 = millis();
        deleteAllChildCards(1);
        Firebase.setBool(fbdo, "/kho1/childlock1", true);
        Firebase.setBool(fbdo, "/kho1/alarm1", true);
        postDisplayMessage("CHILD CARDS LOCKED P1\nSYSTEM ALERT");
      }
    }
    inputPassword1 = "";
    currentMode1 = MODE_NORMAL;
  } else {
    if (inputPassword2 == correctPassword2) {
      resetFailedAttempts(2);
      openLock(2);
      postDisplayMessage("SUCCESS P2\nAccess granted");
      beepBuzzerShort();
    } else {
      failedAttempts2++;
      saveFailedAttempts(2);
      char buf[64];
      snprintf(buf, sizeof(buf), "FAIL P2\nFailed: %d/%d", failedAttempts2, MAX_FAILED_ATTEMPTS_LOCK);
      postDisplayMessage(buf);
      if (failedAttempts2 == MAX_FAILED_ATTEMPTS_WARNING) {
          lastFailedSMSTime2 = millis();
          sendSMS(ALLOWED_PHONE_2, "Canh bao: Kho P2 nhap sai mat khau 5 lan!");
          delay(100);
      }
      else if (failedAttempts2 > MAX_FAILED_ATTEMPTS_WARNING && failedAttempts2 < MAX_FAILED_ATTEMPTS_LOCK) beepWarning5s();
      else if (failedAttempts2 >= MAX_FAILED_ATTEMPTS_LOCK) {
        sendSMS(ALLOWED_PHONE_2, "Khoa kich hoat: Kho P2 bi khoa do 10 lan that bai!");
        delay(100);
        childCardsLocked2 = true;
        alarmActive2 = true;
        lockStartTime2 = millis();
        deleteAllChildCards(2);
        Firebase.setBool(fbdo, "/kho2/childlock2", true);
        Firebase.setBool(fbdo, "/kho2/alarm2", true);
        postDisplayMessage("CHILD CARDS LOCKED P2\nSYSTEM ALERT");
      }
    }
    inputPassword2 = "";
    currentMode2 = MODE_NORMAL;
  }
}

void TaskMainLogic(void *pvParameters) {
  RFIDMessage rmsg;
  char k;
  for (;;) {
    unsigned long now = millis();
    
    if (relayOnUntil1 && now >= relayOnUntil1) { 
      digitalWrite(RELAY_PIN_1, LOW); 
      relayOnUntil1 = 0;
      Firebase.setBool(fbdo, "/kho1/lock1", false);
    }
    if (relayOnUntil2 && now >= relayOnUntil2) { 
      digitalWrite(RELAY_PIN_2, LOW); 
      relayOnUntil2 = 0;
      Firebase.setBool(fbdo, "/kho2/lock2", false);
    }

    if (xQueueReceive(queueRFID, &rmsg, 0) == pdPASS) {
      displayPriority = true; priorityDisplayTime = now;
      beepBuzzerShort();
      
      if (checkIfMaster(rmsg.uid, rmsg.size, 1)) {
        activeRoom = 1;
        resetFailedAttempts(1);
        isMasterMode1 = true; masterModeStartTime1 = now; currentMode1 = MODE_NORMAL;
        postDisplayMessage("MASTER MODE P1 - 15s\nPress ****** to ADD\nPress ###### to DEL");
        displayPriority = true;
        priorityDisplayTime = millis();
        priorityDisplayDuration = 15000;
        openLock(1);
      } else if (checkIfMaster(rmsg.uid, rmsg.size, 2)) {
        activeRoom = 2;
        resetFailedAttempts(2);
        isMasterMode2 = true; masterModeStartTime2 = now; currentMode2 = MODE_NORMAL;
        postDisplayMessage("MASTER MODE P2 - 15s\nPress ****** to ADD\nPress ###### to DEL");
        displayPriority = true;
        priorityDisplayTime = millis();
        priorityDisplayDuration = 15000;
        openLock(2);
      } else {
        if (isMasterMode1 && (currentMode1 == MODE_ADD_CARD || currentMode1 == MODE_REMOVE_CARD)) {
          if (currentMode1 == MODE_ADD_CARD) handleAddCard(1, rmsg.uid);
          else if (currentMode1 == MODE_REMOVE_CARD) handleRemoveCard(1, rmsg.uid);
          currentMode1 = MODE_NORMAL;
        } else if (isMasterMode2 && (currentMode2 == MODE_ADD_CARD || currentMode2 == MODE_REMOVE_CARD)) {
          if (currentMode2 == MODE_ADD_CARD) handleAddCard(2, rmsg.uid);
          else if (currentMode2 == MODE_REMOVE_CARD) handleRemoveCard(2, rmsg.uid);
          currentMode2 = MODE_NORMAL;
        } else {
          int room = findChildCardRoom(rmsg.uid, rmsg.size);
          if (room != 0) {
            // KIỂM TRA CHILDLOCK TRƯỚC
            if ((room == 1 && childCardsLocked1) || (room == 2 && childCardsLocked2)) {
              if (room == 1) {
                postDisplayMessage("CHILDLOCK P1 ACTIVE\nAccess denied!");
              } else {
                postDisplayMessage("CHILDLOCK P2 ACTIVE\nAccess denied!");
              }
              continue;
            }
            
            // KIỂM TRA MANUAL MODE
            if ((room == 1 && !lastAuto1State) || (room == 2 && !lastAuto2State)) {
              if (room == 1) {
                postDisplayMessage("MANUAL MODE P1\nChild card disabled");
              } else {
                postDisplayMessage("MANUAL MODE P2\nChild card disabled");
              }
              continue;
            }
            
            // Nếu qua được 2 check trên thì mới cho nhập mật khẩu
            activeRoom = room;
            if (room == 1) {
              currentMode1 = MODE_PASSWORD_INPUT; inputPassword1 = "";
              postDisplayMessage("CHILD CARD P1\nEnter Password:");
            } else {
              currentMode2 = MODE_PASSWORD_INPUT; inputPassword2 = "";
              postDisplayMessage("CHILD CARD P2\nEnter Password:");
            }
          } else {
            char buf[48];
            snprintf(buf, sizeof(buf), "ACCESS DENIED\nUNKNOWN CARD");
            postDisplayMessage(buf);
          }
        }
      }
    }

    if (xQueueReceive(queueKeypad, &k, 0) == pdPASS) {
      displayPriority = true; priorityDisplayTime = now;
      
      static String masterCommand1 = "";
      static String masterCommand2 = "";

      if ((isMasterMode1 && (currentMode1 == MODE_ADD_CARD || currentMode1 == MODE_REMOVE_CARD)) ||
          (isMasterMode2 && (currentMode2 == MODE_ADD_CARD || currentMode2 == MODE_REMOVE_CARD))) {
        continue;
      }

      if (isMasterMode1 && currentMode1 == MODE_NORMAL) {
        if (k == '*' || k == '#') {
          masterCommand1 += k;
          char buf[64];
          snprintf(buf, sizeof(buf), "MASTER MODE P1\nCommand: %s", masterCommand1.c_str());
          postDisplayMessage(buf);
          if (masterCommand1 == "******") {
            currentMode1 = MODE_ADD_CARD; masterModeStartTime1 = now; masterCommand1 = "";
            postDisplayMessage("ADD CARD P1\nScan new card...");
          } else if (masterCommand1 == "######") {
            currentMode1 = MODE_REMOVE_CARD; masterModeStartTime1 = now; masterCommand1 = "";
            postDisplayMessage("REMOVE CARD P1\nScan card to delete");
          } else if (masterCommand1.length() == 6 && masterCommand1 != "******" && masterCommand1 != "######") {
            postDisplayMessage("WRONG COMMAND!\nExit Master Mode");
            beepBuzzerShort();
            isMasterMode1 = false; currentMode1 = MODE_NORMAL; digitalWrite(RELAY_PIN_1, LOW);
            masterCommand1 = "";
          }
        }
        continue;
      }
      if (isMasterMode2 && currentMode2 == MODE_NORMAL) {
        if (k == '*' || k == '#') {
          masterCommand2 += k;
          char buf[64];
          snprintf(buf, sizeof(buf), "MASTER MODE P2\nCommand: %s", masterCommand2.c_str());
          postDisplayMessage(buf);
          if (masterCommand2 == "******") {
            currentMode2 = MODE_ADD_CARD; masterModeStartTime2 = now; masterCommand2 = "";
            postDisplayMessage("ADD CARD P2\nScan new card...");
          } else if (masterCommand2 == "######") {
            currentMode2 = MODE_REMOVE_CARD; masterModeStartTime2 = now; masterCommand2 = "";
            postDisplayMessage("REMOVE CARD P2\nScan card to delete");
          } else if (masterCommand2.length() == 6 && masterCommand2 != "******" && masterCommand2 != "######") {
            postDisplayMessage("WRONG COMMAND!\nExit Master Mode");
            beepBuzzerShort();
            isMasterMode2 = false; currentMode2 = MODE_NORMAL; digitalWrite(RELAY_PIN_2, LOW);
            masterCommand2 = "";
          }
        }
        continue;
      }

      int room = activeRoom ? activeRoom : 1;
      if (room == 1) {
        if (currentMode1 == MODE_PASSWORD_INPUT) {
          if (k == '#') {
            checkPasswordNonBlocking(1);
          } else if (k == '*') {
            if (inputPassword1.length() > 0) {
              inputPassword1.remove(inputPassword1.length() - 1);
              String displayStars = "";
              for (int i = 0; i < inputPassword1.length(); i++) {
                displayStars += '*';
              }
              for (int i = inputPassword1.length(); i < PASSWORD_LENGTH; i++) {
                displayStars += ' ';
              }
              postDisplayMessage(("CHILD CARD P1\nEnter Password:\n" + displayStars).c_str());
            } else {
              postDisplayMessage("CHILD CARD P1\nEnter Password:\n      ");
            }
          } else if (k >= '0' && k <= '9') {
            if (inputPassword1.length() < PASSWORD_LENGTH) {
              inputPassword1 += k;
              String displayStars = "";
              for (int i = 0; i < inputPassword1.length(); i++) {
                displayStars += '*';
              }
              for (int i = inputPassword1.length(); i < PASSWORD_LENGTH; i++) {
                displayStars += ' ';
              }
              postDisplayMessage(("CHILD CARD P1\nEnter Password:\n" + displayStars).c_str());
              if (inputPassword1.length() == PASSWORD_LENGTH) checkPasswordNonBlocking(1);
            }
          }
        }
      } else {
        if (currentMode2 == MODE_PASSWORD_INPUT) {
          if (k == '#') {
            checkPasswordNonBlocking(2);
          } else if (k == '*') {
            if (inputPassword2.length() > 0) {
              inputPassword2.remove(inputPassword2.length() - 1);
              String displayStars = "";
              for (int i = 0; i < inputPassword2.length(); i++) {
                displayStars += '*';
              }
              for (int i = inputPassword2.length(); i < PASSWORD_LENGTH; i++) {
                displayStars += ' ';
              }
              postDisplayMessage(("CHILD CARD P2\nEnter Password:\n" + displayStars).c_str());
            } else {
              postDisplayMessage("CHILD CARD P2\nEnter Password:\n      ");
            }
          } else if (k >= '0' && k <= '9') {
            if (inputPassword2.length() < PASSWORD_LENGTH) {
              inputPassword2 += k;
              String displayStars = "";
              for (int i = 0; i < inputPassword2.length(); i++) {
                displayStars += '*';
              }
              for (int i = inputPassword2.length(); i < PASSWORD_LENGTH; i++) {
                displayStars += ' ';
              }
              postDisplayMessage(("CHILD CARD P2\nEnter Password:\n" + displayStars).c_str());
              if (inputPassword2.length() == PASSWORD_LENGTH) checkPasswordNonBlocking(2);
            }
          }
        }
      }
    }

    if (isMasterMode1 && currentMode1 == MODE_NORMAL && (now - masterModeStartTime1 > MASTER_MODE_DURATION)) {
      isMasterMode1 = false; currentMode1 = MODE_NORMAL; digitalWrite(RELAY_PIN_1, LOW);
      postDisplayMessage("MASTER MODE P1\nTimeout");
      displayPriority = true;
      priorityDisplayTime = millis();
      priorityDisplayDuration = 2000;
    }
    if (isMasterMode2 && currentMode2 == MODE_NORMAL && (now - masterModeStartTime2 > MASTER_MODE_DURATION)) {
      isMasterMode2 = false; currentMode2 = MODE_NORMAL; digitalWrite(RELAY_PIN_2, LOW);
      postDisplayMessage("MASTER MODE P2\nTimeout");
      displayPriority = true;
      priorityDisplayTime = millis();
      priorityDisplayDuration = 2000;
    }

    if ((currentMode1 == MODE_ADD_CARD || currentMode1 == MODE_REMOVE_CARD) && (now - masterModeStartTime1 > OPERATION_DURATION)) {
      currentMode1 = MODE_NORMAL; isMasterMode1 = false; digitalWrite(RELAY_PIN_1, LOW); postDisplayMessage("OPERATION P1\nTimeout");
    }
    if ((currentMode2 == MODE_ADD_CARD || currentMode2 == MODE_REMOVE_CARD) && (now - masterModeStartTime2 > OPERATION_DURATION)) {
      currentMode2 = MODE_NORMAL; isMasterMode2 = false; digitalWrite(RELAY_PIN_2, LOW); postDisplayMessage("OPERATION P2\nTimeout");
    }

    vTaskDelay(pdMS_TO_TICKS(20));
  }
}

