    } else {
      Firebase.setString(fbdo, "/kho2/pass2", correctPassword2);
      Serial.println("Invalid initial password2, set to default: " + correctPassword2);
    }
  }

  pref1.begin("smart-lock1", false);
  pref2.begin("smart-lock2", false);

  displayMutex = xSemaphoreCreateMutex();
  prefsMutex = xSemaphoreCreateMutex();
  queueRFID = xQueueCreate(8, sizeof(RFIDMessage));
  queueKeypad = xQueueCreate(16, sizeof(char));
  queueDisplayIndex = xQueueCreate(8, sizeof(int));

  failedAttempts1 = pref1.getInt("failedAttempts", 0);
  if (failedAttempts1 >= MAX_FAILED_ATTEMPTS_LOCK) { childCardsLocked1 = true; childCount1 = 0; }
  else loadChildCardsFromPreferences(1);

  failedAttempts2 = pref2.getInt("failedAttempts", 0);
  if (failedAttempts2 >= MAX_FAILED_ATTEMPTS_LOCK) { childCardsLocked2 = true; childCount2 = 0; }
  else loadChildCardsFromPreferences(2);

  Wire.begin(OLED_SDA, OLED_SCL);
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    for (;;);
  }

  for (byte r = 0; r < ROWS; r++) pinMode(rowPins[r], INPUT_PULLUP);
  for (byte c = 0; c < COLS; c++) { pinMode(colPins[c], OUTPUT); digitalWrite(colPins[c], HIGH); }

  SPI.begin(SCK_PIN, MISO_PIN, MOSI_PIN, SS_PIN);
  mfrc522.PCD_Init();

  pinMode(RELAY_PIN_1, OUTPUT); pinMode(RELAY_PIN_2, OUTPUT);
  pinMode(PIR_RELAY_PIN_1, OUTPUT); pinMode(PIR_RELAY_PIN_2, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(EMERGENCY_BUTTON_PIN_1, INPUT_PULLUP);
  pinMode(EMERGENCY_BUTTON_PIN_2, INPUT_PULLUP);
  digitalWrite(RELAY_PIN_1, LOW); digitalWrite(RELAY_PIN_2, LOW);
  digitalWrite(PIR_RELAY_PIN_1, LOW); digitalWrite(PIR_RELAY_PIN_2, LOW);
  digitalWrite(BUZZER_PIN, LOW);
  pinMode(PIR_PIN_1, INPUT); pinMode(PIR_PIN_2, INPUT);

  moduleSim.begin(115200, SERIAL_8N1, RX_PIN, TX_PIN);
  delay(2000);
  moduleSim.println("AT"); delay(100);
  moduleSim.println("ATE0"); delay(50);
  moduleSim.println("AT+CMGF=1"); delay(50);
  moduleSim.println("AT+CNMI=2,2,0,0,0"); delay(50);

  pinMode(DHT_PIN_1, INPUT_PULLUP); pinMode(DHT_PIN_2, INPUT_PULLUP);
  dht1.begin(); dht2.begin();

  pinMode(LED_PIN, OUTPUT); digitalWrite(LED_PIN, LOW);
  analogReadResolution(12);

  // ========= KHỞI TẠO CACHE DHT =========
  delay(2000); // Chờ DHT khởi động
  
  // Đọc giá trị ban đầu cho cache
  cachedTemp1 = dht1.readTemperature();
  cachedHum1 = dht1.readHumidity();
  delay(50);
  cachedTemp2 = dht2.readTemperature();
  cachedHum2 = dht2.readHumidity();
  
  // Kiểm tra và set valid flag (CHỈ CHECK NAN)
  dhtCacheValid1 = (!isnan(cachedTemp1) && !isnan(cachedHum1));
  dhtCacheValid2 = (!isnan(cachedTemp2) && !isnan(cachedHum2));
  // =====================================

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0,0);
  display.println("RFID + Envi + PIR");
  display.setCursor(0,10);
  display.println("System Starting...");
  display.setCursor(0,20);
  display.print("Cards1:"); display.print(childCount1);
  display.print(" Cards2:"); display.print(childCount2);
  display.display();

  if (childCardsLocked1) { postDisplayMessage("CHILD CARDS LOCKED P1"); for (int i=0;i<3;i++){ tone(BUZZER_PIN, 1000, 300); delay(300); } }
  if (childCardsLocked2) { postDisplayMessage("CHILD CARDS LOCKED P2"); for (int i=0;i<3;i++){ tone(BUZZER_PIN, 1000, 300); delay(300); } }
  if (!childCardsLocked1 && !childCardsLocked2) tone(BUZZER_PIN, 1000, 200);

  xTaskCreate(TaskMainLogic, "TaskMain", 8192, NULL, 6, NULL);         // CAO: 
  xTaskCreate(TaskRFID, "TaskRFID", 4096, NULL, 5, NULL);              // TRUNG BÌNH CAO
  xTaskCreate(TaskSensors, "TaskSensors", 4096, NULL, 4, NULL);        // TRUNG BÌNH 
  xTaskCreate(TaskKeypad, "TaskKeypad", 3072, NULL, 4, NULL);          // TRUNG BÌNH
  xTaskCreate(TaskSMS, "TaskSMS", 8192, NULL, 3, NULL);                // ƯU TIÊN SMS HƠN
  xTaskCreate(TaskFirebase, "TaskFirebase", 8192, NULL, 2, NULL);      // THẤP
  xTaskCreate(TaskDisplay, "TaskDisplay", 4096, NULL, 1, NULL);        // THẤP NHẤT

  for (int i=0;i<DISPLAY_POOL_SIZE;i++) displayPool[i][0]=0;
  delay(1500);
}

void loop() {
  vTaskDelay(pdMS_TO_TICKS(1000));
}


