// -------------------- Display queue helper --------------------
int allocateDisplaySlot(const char* txt) {
  for (int i=0;i<DISPLAY_POOL_SIZE;i++) {
    if (displayPool[i][0] == 0) {
      strncpy(displayPool[i], txt, DISPLAY_MSG_LEN-1);
      displayPool[i][DISPLAY_MSG_LEN-1] = 0;
      return i;
    }
  }
  strncpy(displayPool[0], txt, DISPLAY_MSG_LEN-1);
  displayPool[0][DISPLAY_MSG_LEN-1] = 0;
  return 0;
}

void postDisplayMessage(const char* txt) {
  int idx = allocateDisplaySlot(txt);
  xQueueSend(queueDisplayIndex, &idx, 0);
}

