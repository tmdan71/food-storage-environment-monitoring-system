// -------------------- HÀM CONTROL BUZZER & LED (NHẤP NHÁY 200ms) --------------------
void controlBuzzerAndLED(float temperature, float humidity, int room) {
  // CHỈ CHECK NAN, KHÔNG CHECK == 0
  if (isnan(temperature) || isnan(humidity)) {
    return; // Bỏ qua nếu giá trị không hợp lệ
  }
  
  static unsigned long lastBlinkTime1 = 0;
  static unsigned long lastBlinkTime2 = 0;
  static bool blinkState1 = false;
  static bool blinkState2 = false;
  static bool wasWarning1 = false;
  static bool wasWarning2 = false;
  unsigned long currentMillis = millis();

  // Nếu đang báo động ChildLock, ưu tiên cảnh báo đó (liên tục)
  if (room == 1 && alarmActive1) {
    digitalWrite(LED_PIN, HIGH);
    tone(BUZZER_PIN, 1200);
    return;
  }
  if (room == 2 && alarmActive2) {
    digitalWrite(LED_PIN, HIGH);
    tone(BUZZER_PIN, 1200);
    return;
  }

  if (room == 1) {
    // KIỂM TRA CÓ VƯỢT NGƯỠNG KHÔNG (LOW hoặc HIGH)
    bool isOutOfRange = (temperature <= lowTemp1 || temperature >= highTemp1 || 
                         humidity <= lowHum1 || humidity >= highHum1);
    
    if (isOutOfRange) {
      wasWarning1 = true;
      
      // NHẤP NHÁY 200ms (bật 100ms, tắt 100ms)
      if (currentMillis - lastBlinkTime1 >= 100) {
        lastBlinkTime1 = currentMillis;
        blinkState1 = !blinkState1;
        
        if (blinkState1) {
          digitalWrite(LED_PIN, HIGH);
          tone(BUZZER_PIN, 1000);
        } else {
          digitalWrite(LED_PIN, LOW);
          noTone(BUZZER_PIN);
        }
      }
    } else {
      if (wasWarning1) {
        // TẮT CẢNH BÁO KHI TRỞ LẠI BÌNH THƯỜNG
        digitalWrite(LED_PIN, LOW);
        noTone(BUZZER_PIN);
        wasWarning1 = false;
        blinkState1 = false;
      }
    }
  } 
  else { // Room 2
    bool isOutOfRange = (temperature <= lowTemp2 || temperature >= highTemp2 || 
                         humidity <= lowHum2 || humidity >= highHum2);
    
    if (isOutOfRange) {
      wasWarning2 = true;
      
      // NHẤP NHÁY 200ms (bật 100ms, tắt 100ms)
      if (currentMillis - lastBlinkTime2 >= 100) {
        lastBlinkTime2 = currentMillis;
        blinkState2 = !blinkState2;
        
        if (blinkState2) {
          digitalWrite(LED_PIN, HIGH);
          tone(BUZZER_PIN, 1000);
        } else {
          digitalWrite(LED_PIN, LOW);
          noTone(BUZZER_PIN);
        }
      }
    } else {
      if (wasWarning2) {
        digitalWrite(LED_PIN, LOW);
        noTone(BUZZER_PIN);
        wasWarning2 = false;
        blinkState2 = false;
      }
    }
  }
}

