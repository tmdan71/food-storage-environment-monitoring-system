// Hàm reset bảo mật khi mở khóa bằng Firebase hoặc SMS
void resetSecurityOnFirebaseOpen(int room) {
  if (room == 1) {
    if (failedAttempts1 > 0 || childCardsLocked1) {
      resetFailedAttempts(1);
    }
  } else {
    if (failedAttempts2 > 0 || childCardsLocked2) {
      resetFailedAttempts(2);
    }
  }
}

// Hàm reset về trạng thái auto mode bình thường
void resetToAutoState(int room) {
  if (room == 1) {
    if (digitalRead(RELAY_PIN_1) == HIGH) {
      digitalWrite(RELAY_PIN_1, LOW);
      relayOnUntil1 = 0;
    }
    
    if (digitalRead(PIR_RELAY_PIN_1) == HIGH && lightOnUntil1 == 0) {
      digitalWrite(PIR_RELAY_PIN_1, LOW);
    }
    
    lightOnUntil1 = 0;
    motionDetected1 = false;
    
    Firebase.setBool(fbdo, "/kho1/lock1", false);
    Firebase.setBool(fbdo, "/kho1/light1", false);
    
  } else {
    if (digitalRead(RELAY_PIN_2) == HIGH) {
      digitalWrite(RELAY_PIN_2, LOW);
      relayOnUntil2 = 0;
    }
    
    if (digitalRead(PIR_RELAY_PIN_2) == HIGH && lightOnUntil2 == 0) {
      digitalWrite(PIR_RELAY_PIN_2, LOW);
    }
    
    lightOnUntil2 = 0;
    motionDetected2 = false;
    
    Firebase.setBool(fbdo, "/kho2/lock2", false);
    Firebase.setBool(fbdo, "/kho2/light2", false);
  }
}

// Hàm điều khiển từ Firebase xuống
bool controlFromFirebase() {
  bool newLock1, newLock2, newLight1, newLight2, newAuto1, newAuto2, newChildLock1, newChildLock2;
  bool hasChange = false;
  
  // Đọc chế độ auto từ Firebase
  if (Firebase.getBool(fbdo, "/kho1/auto1")) {
    newAuto1 = fbdo.boolData();
    if (newAuto1 != lastAuto1State) {
      hasChange = true;
      
      if (lastAuto1State == false && newAuto1 == true) {
        resetToAutoState(1);
      }
      
      lastAuto1State = newAuto1;
    }
  }
  
  if (Firebase.getBool(fbdo, "/kho2/auto2")) {
    newAuto2 = fbdo.boolData();
    if (newAuto2 != lastAuto2State) {
      hasChange = true;
      
      if (lastAuto2State == false && newAuto2 == true) {
        resetToAutoState(2);
      }
      
      lastAuto2State = newAuto2;
    }
  }
  
  // Điều khiển childlock từ Firebase
  if (Firebase.getBool(fbdo, "/kho1/childlock1")) {
    newChildLock1 = fbdo.boolData();
    if (newChildLock1 != childCardsLocked1) {
      hasChange = true;
      if (!newChildLock1 && childCardsLocked1) {
        // Mở khóa thẻ con và reset số lần sai
        resetFailedAttempts(1);
        postDisplayMessage("CHILDLOCK P1: OFF\nSystem reset");
      } else if (newChildLock1 && !childCardsLocked1) {
        // Kích hoạt khóa thẻ con
        childCardsLocked1 = true;
        alarmActive1 = true;
        postDisplayMessage("CHILDLOCK P1: ON\nALARM ACTIVATED");
      }
      childCardsLocked1 = newChildLock1;
    }
  }
  
  if (Firebase.getBool(fbdo, "/kho2/childlock2")) {
    newChildLock2 = fbdo.boolData();
    if (newChildLock2 != childCardsLocked2) {
      hasChange = true;
      if (!newChildLock2 && childCardsLocked2) {
        // Mở khóa thẻ con và reset số lần sai
        resetFailedAttempts(2);
        postDisplayMessage("CHILDLOCK P2: OFF\nSystem reset");
      } else if (newChildLock2 && !childCardsLocked2) {
        // Kích hoạt khóa thẻ con
        childCardsLocked2 = true;
        alarmActive2 = true;
        postDisplayMessage("CHILDLOCK P2: ON\nALARM ACTIVATED");
      }
      childCardsLocked2 = newChildLock2;
    }
  }
  
  // Khi auto = false, chỉ nhận lệnh từ Firebase cho lock và light
  if (!lastAuto1State) {
    if (Firebase.getBool(fbdo, "/kho1/lock1")) {
      newLock1 = fbdo.boolData();
      if (newLock1 != lastLock1State) {
        hasChange = true;
        lastLock1State = newLock1;
        if (newLock1 && digitalRead(RELAY_PIN_1) == LOW) {
          resetSecurityOnFirebaseOpen(1);
          openLock(1);
        }
      }
    }
    
    if (Firebase.getBool(fbdo, "/kho1/light1")) {
      newLight1 = fbdo.boolData();
      if (newLight1 != lastLight1State) {
        hasChange = true;
        lastLight1State = newLight1;
        if (newLight1 && digitalRead(PIR_RELAY_PIN_1) == LOW) {
          turnOnLight(1);
        } else if (!newLight1 && digitalRead(PIR_RELAY_PIN_1) == HIGH) {
          turnOffLight(1);
        }
      }
    }
  }
  
  if (!lastAuto2State) {
    if (Firebase.getBool(fbdo, "/kho2/lock2")) {
      newLock2 = fbdo.boolData();
      if (newLock2 != lastLock2State) {
        hasChange = true;
        lastLock2State = newLock2;
        if (newLock2 && digitalRead(RELAY_PIN_2) == LOW) {
          resetSecurityOnFirebaseOpen(2);
          openLock(2);
        }
      }
    }
    
    if (Firebase.getBool(fbdo, "/kho2/light2")) {
      newLight2 = fbdo.boolData();
      if (newLight2 != lastLight2State) {
        hasChange = true;
        lastLight2State = newLight2;
        if (newLight2 && digitalRead(PIR_RELAY_PIN_2) == LOW) {
          turnOnLight(2);
        } else if (!newLight2 && digitalRead(PIR_RELAY_PIN_2) == HIGH) {
          turnOffLight(2);
        }
      }
    }
  }
  
  // Khi auto = true, vẫn cho phép điều khiển từ Firebase
  if (lastAuto1State) {
    if (Firebase.getBool(fbdo, "/kho1/lock1")) {
      newLock1 = fbdo.boolData();
      if (newLock1 != lastLock1State) {
        hasChange = true;
        lastLock1State = newLock1;
        if (newLock1 && digitalRead(RELAY_PIN_1) == LOW) {
          resetSecurityOnFirebaseOpen(1);
          openLock(1);
        }
      }
    }
    
    if (Firebase.getBool(fbdo, "/kho1/light1")) {
      newLight1 = fbdo.boolData();
      if (newLight1 != lastLight1State) {
        hasChange = true;
        lastLight1State = newLight1;
        if (newLight1 && digitalRead(PIR_RELAY_PIN_1) == LOW) {
          turnOnLight(1);
        }
      }
    }
  }
  
  if (lastAuto2State) {
    if (Firebase.getBool(fbdo, "/kho2/lock2")) {
      newLock2 = fbdo.boolData();
      if (newLock2 != lastLock2State) {
        hasChange = true;
        lastLock2State = newLock2;
        if (newLock2 && digitalRead(RELAY_PIN_2) == LOW) {
          resetSecurityOnFirebaseOpen(2);
          openLock(2);
        }
      }
    }
    
    if (Firebase.getBool(fbdo, "/kho2/light2")) {
      newLight2 = fbdo.boolData();
      if (newLight2 != lastLight2State) {
        hasChange = true;
        lastLight2State = newLight2;
        if (newLight2 && digitalRead(PIR_RELAY_PIN_2) == LOW) {
          turnOnLight(2);
        }
      }
    }
  }
  
  return hasChange;
}

// Hàm mở khóa (luôn tự đóng sau 5s)
void openLock(int room) {
  unsigned long now = millis();
  if (room == 1) {
    digitalWrite(RELAY_PIN_1, HIGH);
    relayOnUntil1 = now + 5000;
    Firebase.setBool(fbdo, "/kho1/lock1", true);
    beepBuzzerShort();
  } else {
    digitalWrite(RELAY_PIN_2, HIGH);
    relayOnUntil2 = now + 5000;
    Firebase.setBool(fbdo, "/kho2/lock2", true);
    beepBuzzerShort();
  }
}

// Hàm bật đèn
void turnOnLight(int room) {
  unsigned long now = millis();
  if (room == 1) {
    digitalWrite(PIR_RELAY_PIN_1, HIGH);
    if (lastAuto1State) {
      lightOnUntil1 = now + MOTION_TIMEOUT;
    } else {
      lightOnUntil1 = 0;
    }
    Firebase.setBool(fbdo, "/kho1/light1", true);
  } else {
    digitalWrite(PIR_RELAY_PIN_2, HIGH);
    if (lastAuto2State) {
      lightOnUntil2 = now + MOTION_TIMEOUT;
    } else {
      lightOnUntil2 = 0;
    }
    Firebase.setBool(fbdo, "/kho2/light2", true);
  }
}

