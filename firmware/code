  if (Firebase.getString(fbdo, "/kho1/pass1")) {
    String newPass1 = fbdo.stringData();
    if (newPass1.length() == 6) {
      correctPassword1 = newPass1;
      Serial.println("Initial password1: " + correctPassword1);
    } else {
      Firebase.setString(fbdo, "/kho1/pass1", correctPassword1);
      Serial.println("Invalid initial password1, set to default: " + correctPassword1);
